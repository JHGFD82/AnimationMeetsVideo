{
  "formatVersion": 1,
  "id": "cosinePalette",
  "version": 1,
  "name": "Cosine Palette",
  "category": "recolor",
  "symbol": "rainbow",
  "kernel": {"file": "kernel.metal", "function": "amvCosinePalette", "type": "color"},
  "controls": [
    {"id": "palette", "name": "Palette", "type": "choice", "default": "rainbow", "options": [{"id": "rainbow", "name": "Rainbow"}, {"id": "acid", "name": "Acid"}, {"id": "infrared", "name": "Infrared"}, {"id": "oilSlick", "name": "Oil Slick"}, {"id": "custom", "name": "Custom"}]},
    {"id": "cycleSpeed", "name": "Speed", "type": "number", "default": 0, "range": [-20, 20], "unit": "/s", "rate": true},
    {"id": "paletteBias", "name": "Bias", "type": "vector", "components": ["Red", "Green", "Blue"], "default": [0.5, 0.5, 0.5], "range": [-2, 2], "step": 0.01},
    {"id": "paletteAmplitude", "name": "Amplitude", "type": "vector", "components": ["Red", "Green", "Blue"], "default": [0.5, 0.5, 0.5], "range": [-2, 2], "step": 0.01},
    {"id": "paletteFrequency", "name": "Frequency", "type": "vector", "components": ["Red", "Green", "Blue"], "default": [1, 1, 1], "range": [0, 8], "step": 0.01},
    {"id": "palettePhase", "name": "Phase", "type": "vector", "components": ["Red", "Green", "Blue"], "default": [0, 0.33, 0.67], "range": [-2, 2], "step": 0.01}
  ],
  "amount": true,
  "arguments": ["index(palette)", "paletteBias", "paletteAmplitude", "paletteFrequency", "palettePhase", "fract(cycleSpeed * seconds)"]
}

{
  "formatVersion": 1,
  "id": "threshold",
  "version": 1,
  "name": "Threshold",
  "category": "correction",
  "symbol": "rectangle.lefthalf.filled",
  "kernel": {"file": "kernel.metal", "function": "amvThreshold", "type": "color"},
  "controls": [
    {"id": "thresholdLevel", "name": "Level", "type": "number", "default": 50, "range": [0, 100], "unit": "%"},
    {"id": "thresholdSoftness", "name": "Softness", "type": "number", "default": 0, "range": [0, 100], "unit": "%"},
    {"id": "thresholdChannels", "name": "Channels", "type": "choice", "default": "brightness", "options": [{"id": "brightness", "name": "Brightness"}, {"id": "each", "name": "Each Channel"}]}
  ],
  "amount": true,
  "graph": {"handles": [
    {"name": "Level", "x": "thresholdLevel / 100", "y": "0.5", "set": {"thresholdLevel": "x * 100"}},
    {"name": "Softness", "x": "(thresholdLevel + thresholdSoftness / 2) / 100", "y": "1",
     "set": {"thresholdSoftness": "max(x * 100 - thresholdLevel, 0) * 2"}}
  ]},
  "arguments": ["thresholdLevel / 100", "thresholdSoftness / 100", "index(thresholdChannels)"]
}

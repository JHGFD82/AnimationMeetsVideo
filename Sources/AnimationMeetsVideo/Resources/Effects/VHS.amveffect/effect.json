{
  "formatVersion": 1,
  "id": "vhs",
  "version": 1,
  "name": "VHS",
  "category": "stylize",
  "symbol": "recordingtape",
  "kernel": {"file": "kernel.metal", "function": "amvVHS", "type": "general"},
  "controls": [
    {"id": "tapeWear", "name": "Wear", "type": "number", "default": 50, "range": [0, 100], "unit": "%"},
    {"id": "colorBleed", "name": "Color Bleed", "type": "number", "default": 6, "range": [0, 40], "unit": "px", "step": 0.1},
    {"id": "trackingError", "name": "Tracking", "type": "number", "default": 30, "range": [0, 100], "unit": "%"},
    {"id": "tapeNoise", "name": "Noise", "type": "number", "default": 30, "range": [0, 100], "unit": "%"},
    {"id": "seed", "name": "Seed", "type": "number", "default": 1, "range": [0, 100000], "whole": true}
  ],
  "amount": true,
  "arguments": ["scale", "tapeWear / 100", "colorBleed * scale", "trackingError / 100", "tapeNoise / 100", "seed", "frame", "seconds", "frameCenter", "frameHeight"],
  "changesEveryFrame": true,
  "reach": "(colorBleed + 32) * scale",
  "input": "clamped"
}

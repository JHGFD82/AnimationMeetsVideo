{
  "formatVersion": 1,
  "id": "solarize",
  "version": 1,
  "name": "Solarize",
  "category": "recolor",
  "symbol": "sun.max.trianglebadge.exclamationmark",
  "kernel": {"file": "kernel.metal", "function": "amvSolarize", "type": "color"},
  "controls": [
    {"id": "solarizeLevel", "name": "Threshold", "type": "number", "default": 50, "range": [1, 99], "unit": "%"},
    {"id": "folds", "name": "Folds", "type": "number", "default": 1, "range": [1, 16], "whole": true},
    {"id": "solarizeChannels", "name": "Channels", "type": "choice", "default": "luminance", "options": [{"id": "luminance", "name": "Brightness"}, {"id": "each", "name": "Each Channel"}]}
  ],
  "amount": true,
  "graph": {"handles": [
    {"name": "Threshold", "x": "solarizeLevel / 100", "y": "solarizeLevel / 100", "set": {"solarizeLevel": "x * 100"}}
  ]},
  "arguments": ["solarizeLevel / 100", "folds", "index(solarizeChannels)"]
}

{
  "formatVersion": 1,
  "id": "rectangleMask",
  "version": 1,
  "name": "Box Mask",
  "category": "keying",
  "symbol": "rectangle.dashed",
  "kernel": {"file": "kernel.metal", "function": "amvRectangleMask", "type": "color"},
  "controls": [
    {"id": "maskCenter", "name": "Center", "type": "point"},
    {"id": "maskSize", "name": "Size", "type": "vector", "components": ["Width", "Height"], "default": [960, 540], "range": [0, 100000], "unit": "px"},
    {"id": "maskRoundness", "name": "Roundness", "type": "number", "default": 0, "range": [0, 50000], "unit": "px"},
    {"id": "maskFeather", "name": "Feather", "type": "number", "default": 20, "range": [0, 10000], "unit": "px"},
    {"id": "maskAngle", "name": "Angle", "type": "number", "default": 0, "unit": "°"},
    {"id": "maskKeep", "name": "Keep", "type": "choice", "default": "inside", "options": [{"id": "inside", "name": "Inside"}, {"id": "outside", "name": "Outside"}]}
  ],
  "amount": true,
  "arguments": ["center(maskCenter)", "maskSize", "scale", "maskRoundness * scale", "maskFeather * scale", "-rad(maskAngle)", "index(maskKeep)"],
  "viewer": {
    "handles": [
      {"name": "Width", "x": "maskCenter.x + maskSize.x / 2 * cos(rad(maskAngle))", "y": "maskCenter.y + maskSize.x / 2 * sin(rad(maskAngle))", "set": {"maskSize.x": "2 * abs((x - maskCenter.x) * cos(rad(maskAngle)) + (y - maskCenter.y) * sin(rad(maskAngle)))"}},
      {"name": "Height", "x": "maskCenter.x - maskSize.y / 2 * sin(rad(maskAngle))", "y": "maskCenter.y + maskSize.y / 2 * cos(rad(maskAngle))", "set": {"maskSize.y": "2 * abs((y - maskCenter.y) * cos(rad(maskAngle)) - (x - maskCenter.x) * sin(rad(maskAngle)))"}},
      {"name": "Angle", "x": "maskCenter.x + (maskSize.x / 2 + 48) * cos(rad(maskAngle))", "y": "maskCenter.y + (maskSize.x / 2 + 48) * sin(rad(maskAngle))", "set": {"maskAngle": "maskAngle + (deg(atan2(y - maskCenter.y, x - maskCenter.x)) - maskAngle) - 360 * round((deg(atan2(y - maskCenter.y, x - maskCenter.x)) - maskAngle) / 360)"}}
    ],
    "guides": [
      {"rectangle": {"center": "maskCenter", "size": "maskSize", "angle": "maskAngle"}},
      {"line": ["maskCenter", ["maskCenter.x + (maskSize.x / 2 + 48) * cos(rad(maskAngle))", "maskCenter.y + (maskSize.x / 2 + 48) * sin(rad(maskAngle))"]]}
    ]
  }
}
